NODE_ENV=production
ELERA=0
PORT=8080
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=healthcheck
MARIADB_PASSWORD=
MARIADB_DATABASE=mysql

# Optional managed service accounts created by metadata initialization.
# ELERA_SST_USER=sst
# ELERA_SST_PASSWORD=replace-me
# ELERA_HEALTH_USER=healthcheck
# ELERA_HEALTH_PASSWORD=replace-me

# Optional comma-separated supervisor API peers for one-second observation refresh.
# ELERA_PEERS=http://elera-2:8080,http://elera-3:8080
# ELERA_PEER_TOKEN=replace-with-peer-token
ELERA_OBSERVATION_STATE_PATH=
ELERA_QUERY_TIMEOUT_MS=5000
ELERA_CLUSTER_NAME=local-elera
ELERA_CLUSTER_ADDRESS=gcomm://
ELERA_BOOTSTRAP=false
ELERA_NODE_NAME=elera
ELERA_NODE_ADDRESS=127.0.0.1
ROOT_TOKEN=root_token_here
ELERA_CREDENTIAL_KEY=replace-with-gitops-secret
