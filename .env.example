NODE_ENV=production
ELERA_HTTP_PORT=8080
ELERA_API_PROTOCOL=http
ELERA_API_PROXY=haproxy
ELERA_API_PORT=8080
# Optional comma-separated supervisor API peers for one-second observation refresh.
# ELERA_PEERS=http://elera-2:8080,http://elera-3:8080
# ELERA_PEER_TOKEN=replace-with-peer-token
ELERA_OBSERVATION_STATE_PATH=
ELERA_QUERY_TIMEOUT_MS=5000
ROOT_TOKEN=root_token_here
ELERA_CREDENTIAL_KEY=replace-with-gitops-secret
