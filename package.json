{
  "name": "@eliware/galera",
  "version": "0.1.0",
  "private": true,
  "description": "MariaDB Galera container supervisor and health service",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "check": "node --check src/main.mjs",
    "contracts": "node scripts/verify-contracts.mjs",
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "pack": "npm pack --dry-run"
  },
  "dependencies": {
    "@eliware/common": "2.0.0",
    "@eliware/galera-lib": "file:../galera-lib"
  },
  "devDependencies": {
    "@eliware/test": "2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
