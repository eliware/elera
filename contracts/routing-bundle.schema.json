{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliware.dev/contracts/routing-bundle.schema.json",
  "type": "object",
  "required": ["apiVersion", "application", "database", "identity", "credentials", "routes", "writer", "failover", "readers", "bundleVersion", "expiresAt", "nodeIdentity", "ports"],
  "properties": { "apiVersion": { "const": "v1" }, "application": { "type": "string", "minLength": 1 }, "database": { "type": "string", "minLength": 1 }, "identity": { "type": "string", "minLength": 1 }, "credentials": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string", "minLength": 1 }, "password": { "type": "string" } }, "additionalProperties": false }, "routes": { "type": "object", "required": ["primary", "balanced"], "properties": { "primary": { "$ref": "#/$defs/nodes" }, "balanced": { "$ref": "#/$defs/nodes" } }, "additionalProperties": false }, "writer": { "$ref": "#/$defs/node" }, "failover": { "$ref": "#/$defs/nodes" }, "readers": { "$ref": "#/$defs/nodes" }, "bundleVersion": { "type": ["string", "number"] }, "refreshAfter": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" }, "nodeIdentity": { "type": "string", "minLength": 1 }, "ports": { "type": "object", "required": ["sql", "http"], "properties": { "sql": { "type": "integer", "const": 3306 }, "http": { "type": "integer", "minimum": 1, "maximum": 65535 } }, "additionalProperties": false } },
  "$defs": { "node": { "type": "object", "required": ["host", "port"], "properties": { "host": { "type": "string", "minLength": 1 }, "port": { "type": "integer", "const": 3306 }, "weight": { "type": "number", "minimum": 0 }, "nodeId": { "type": "string", "minLength": 1 } }, "additionalProperties": false }, "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } } },
  "additionalProperties": false
}
