{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliware.dev/contracts/routing-bundle.schema.json",
  "type": "object",
  "required": ["apiVersion", "database", "identity", "credentials", "writer", "readers", "bundleVersion", "expiresAt"],
  "properties": { "apiVersion": { "const": "v1" }, "database": { "type": "string", "minLength": 1 }, "identity": { "type": "string", "minLength": 1 }, "credentials": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string", "minLength": 1 }, "password": { "type": "string" } }, "additionalProperties": false }, "writer": { "$ref": "#/$defs/nodes" }, "readers": { "$ref": "#/$defs/nodes" }, "bundleVersion": { "type": ["string", "number"] }, "refreshAfter": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" } },
  "$defs": { "nodes": { "type": "array", "items": { "type": "object", "required": ["host", "port"], "properties": { "host": { "type": "string", "minLength": 1 }, "port": { "type": "integer", "const": 3306 }, "weight": { "type": "number", "minimum": 0 } }, "additionalProperties": false } } },
  "additionalProperties": false
}
