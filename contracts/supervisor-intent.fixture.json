{
  "apiVersion": "galera.eliware.dev/v1alpha1",
  "kind": "SupervisorIntent",
  "cluster": { "name": "local-galera", "members": [{ "name": "galera-1", "address": "galera-1", "port": 3306 }] },
  "mariadb": { "port": 3306, "dataDir": "/var/lib/mysql", "binlogFormat": "ROW" },
  "routing": { "healthIntervalMs": 1000, "weights": { "galera-1": 1 } },
  "drain": { "queryTimeoutMs": 5000, "shutdownTimeoutMs": 30000 }
}
